{
  "$schema": "./models.schema.json",
  "version": 1,
  "updated": "2026-11-02",
  "notes": [
    "Single source of truth for the LLM Registry app (bundled at build time) and the llm-registry MCP server (read at run time).",
    "modelId is the exact string sent to the provider's API. modelIdVerified=false means it was taken from announcements, not from a provider catalog: confirm it before relying on it, or replace the entry via Settings > Import from OpenRouter / Ollama.",
    "pricing is USD per 1M tokens. null means unknown; the app then shows cost as —.",
    "Groups are tag queries, not lists: a new model lands in the right groups automatically when its tags match."
  ],
  "providers": [
    {
      "id": "anthropic",
      "name": "Anthropic",
      "kind": "anthropic",
      "baseUrl": "https://api.anthropic.com/v1",
      "keyEnv": "ANTHROPIC_API_KEY",
      "browser": true,
      "docs": "https://docs.claude.com",
      "notes": "Direct browser calls need the anthropic-dangerous-direct-browser-access header; the app sends it."
    },
    {
      "id": "openai",
      "name": "OpenAI",
      "kind": "openai-compatible",
      "baseUrl": "https://api.openai.com/v1",
      "keyEnv": "OPENAI_API_KEY",
      "browser": true,
      "docs": "https://platform.openai.com/docs"
    },
    {
      "id": "google",
      "name": "Google AI Studio",
      "kind": "openai-compatible",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
      "keyEnv": "GOOGLE_API_KEY",
      "browser": true,
      "docs": "https://ai.google.dev/gemini-api/docs/openai",
      "notes": "Gemini's OpenAI-compatible endpoint. Free tier available."
    },
    {
      "id": "xai",
      "name": "xAI (SpaceXAI)",
      "kind": "openai-compatible",
      "baseUrl": "https://api.x.ai/v1",
      "keyEnv": "XAI_API_KEY",
      "browser": false,
      "docs": "https://docs.x.ai",
      "notes": "Browser CORS not confirmed; route through OpenRouter or the MCP server if calls fail from the app."
    },
    {
      "id": "openrouter",
      "name": "OpenRouter",
      "kind": "openai-compatible",
      "baseUrl": "https://openrouter.ai/api/v1",
      "keyEnv": "OPENROUTER_API_KEY",
      "browser": true,
      "docs": "https://openrouter.ai/docs",
      "notes": "Gateway to most providers with one key. Rotating set of free models (ids ending in :free). Public catalog at /models needs no key."
    },
    {
      "id": "groq",
      "name": "Groq",
      "kind": "openai-compatible",
      "baseUrl": "https://api.groq.com/openai/v1",
      "keyEnv": "GROQ_API_KEY",
      "browser": true,
      "docs": "https://console.groq.com/docs",
      "notes": "Fast hosted inference for open-weight models. Free tier available."
    },
    {
      "id": "ollama",
      "name": "Ollama (local)",
      "kind": "openai-compatible",
      "baseUrl": "http://localhost:11434/v1",
      "keyEnv": null,
      "browser": true,
      "docs": "https://github.com/ollama/ollama/blob/main/docs/openai.md",
      "notes": "Free, runs on lvp-01 / lvp-02. For browser calls set OLLAMA_ORIGINS to include https://mikecostarella.github.io and http://localhost:5173, then restart Ollama."
    },
    {
      "id": "lmstudio",
      "name": "LM Studio (local)",
      "kind": "openai-compatible",
      "baseUrl": "http://localhost:1234/v1",
      "keyEnv": null,
      "browser": true,
      "docs": "https://lmstudio.ai/docs/api/openai-api",
      "notes": "Enable CORS in LM Studio's server settings for browser calls."
    }
  ],
