  "groups": [
    {
      "id": "frontier-closed",
      "name": "Frontier (closed)",
      "description": "The top closed models from each major lab.",
      "filter": { "access": ["closed"], "allTags": ["frontier"] }
    },
    {
      "id": "open-weight",
      "name": "Open-weight",
      "description": "Anything whose weights you can download.",
      "filter": { "access": ["open-weight", "open-source"] }
    },
    {
      "id": "local",
      "name": "Runs locally",
      "description": "Models served from Ollama or LM Studio on this machine.",
      "filter": { "providers": ["ollama", "lmstudio"] }
    },
    {
      "id": "cheap",
      "name": "Cheap (≤ $1 / 1M input)",
      "description": "Hosted models priced at or below $1 per million input tokens, plus local models.",
      "filter": { "maxInputPrice": 1 }
    },
    {
      "id": "tools",
      "name": "Supports tool use",
      "description": "Models that can call functions / tools — candidates for agentic fleet work.",
      "filter": { "capabilities": ["tools"], "status": ["current", "preview"] }
    },
    {
      "id": "anthropic",
      "name": "Anthropic",
      "description": "The current Claude lineup.",
      "filter": { "providers": ["anthropic"] }
    }
  ],
  "operations": [
    {
      "id": "hello",
      "name": "Smoke test",
      "description": "One-line sanity check that a model answers at all.",
      "system": "",
      "prompt": "Reply with exactly one sentence naming yourself and the lab that built you."
    },
    {
      "id": "explain-moe",
      "name": "Explain MoE (3 sentences)",
      "description": "Compare how models handle a bounded technical explanation.",
      "system": "You are a concise technical writer. Answer in plain prose, no bullet points.",
      "prompt": "Explain what a mixture-of-experts language model is in exactly three sentences, for a software developer who has never trained a model."
    },
    {
      "id": "ts-function",
      "name": "TypeScript: RFC-4180 CSV row",
      "description": "Small coding task with a precise spec, good for spotting sloppy quoting.",
      "system": "You are a senior TypeScript developer. Return only code in one fenced block, then one sentence of notes.",
      "prompt": "Write a TypeScript function csvRow(values: (string | number | null)[]): string that returns one RFC-4180 CSV line: fields containing commas, quotes or newlines are wrapped in double quotes with inner quotes doubled; null becomes an empty field."
    },
    {
      "id": "civic-summary",
      "name": "Civic: summarize for residents",
      "description": "Plain-language rewrite task typical of the civic fleet apps.",
      "system": "You write for city residents at an eighth-grade reading level.",
      "prompt": "Rewrite this for a city website in under 80 words: \"Pursuant to ORC 5705.19, the Board of Trustees has placed a 1.5-mill additional levy on the November ballot for the purpose of providing and maintaining fire apparatus, appliances, buildings, or sites therefor, for a continuing period of time, commencing in tax year 2026, first due in calendar year 2027.\""
    }
  ]
}
